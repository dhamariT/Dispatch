# Postgres connection string used by dispatchd and migrations.
DISPATCH_DATABASE_URL=postgres://dispatch:dispatch@localhost:5432/dispatch?sslmode=disable

# GitHub OAuth app credentials.
# Create one at https://github.com/settings/developers with callback URL:
#   http://localhost:8080/api/auth/github/callback
DISPATCH_GITHUB_CLIENT_ID=
DISPATCH_GITHUB_CLIENT_SECRET=

# Where to send the browser after a successful login.
DISPATCH_LOGIN_REDIRECT=http://localhost:3000

# Random 32-byte hex string used to sign the OAuth state cookie.
# Generate with: openssl rand -hex 32
DISPATCH_SESSION_KEY=

# Set to "true" when serving over HTTPS so session cookies get the Secure flag.
DISPATCH_COOKIE_SECURE=false
